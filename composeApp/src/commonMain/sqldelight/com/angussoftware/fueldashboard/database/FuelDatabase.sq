CREATE TABLE decisions (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    agent_id TEXT NOT NULL,
    model_handle TEXT NOT NULL,
    provider TEXT NOT NULL,
    tier TEXT NOT NULL,
    complexity TEXT NOT NULL,
    utilization_ratio REAL NOT NULL,
    headroom INTEGER NOT NULL,
    reason TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

insertDecision:
INSERT INTO decisions (agent_id, model_handle, provider, tier, complexity, utilization_ratio, headroom, reason, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRecentDecisions:
SELECT * FROM decisions ORDER BY timestamp DESC LIMIT :limit;

CREATE TABLE registered_agents (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    model TEXT,
    framework TEXT,
    command TEXT,
    status TEXT NOT NULL DEFAULT 'registered',
    registered_at INTEGER NOT NULL
);

upsertAgent:
INSERT OR REPLACE INTO registered_agents (id, name, model, framework, command, status, registered_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAgent:
DELETE FROM registered_agents WHERE id = ?;

selectAllAgents:
SELECT * FROM registered_agents;

deleteAllAgents:
DELETE FROM registered_agents;

CREATE TABLE fuel_snapshots (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    tokens_pct REAL,
    session_pct REAL,
    active_agent_count INTEGER NOT NULL DEFAULT 0,
    active_models TEXT,
    reset_at INTEGER
);

insertFuelSnapshot:
INSERT INTO fuel_snapshots (timestamp, tokens_pct, session_pct, active_agent_count, active_models, reset_at)
VALUES (?, ?, ?, ?, ?, ?);

selectRecentFuelSnapshots:
SELECT * FROM fuel_snapshots ORDER BY timestamp DESC LIMIT :limit;

selectFuelSnapshotsSince:
SELECT * FROM fuel_snapshots WHERE timestamp >= :since ORDER BY timestamp ASC;

deleteOldFuelSnapshots:
DELETE FROM fuel_snapshots WHERE timestamp < :cutoff;

CREATE TABLE provider_fuel_snapshots (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    provider_id TEXT NOT NULL,
    provider_name TEXT NOT NULL,
    provider_type TEXT NOT NULL,
    remaining_pct REAL,
    reset_at INTEGER,
    window_hours REAL
);

insertProviderFuelSnapshot:
INSERT INTO provider_fuel_snapshots (timestamp, provider_id, provider_name, provider_type, remaining_pct, reset_at, window_hours)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectProviderFuelSnapshots:
SELECT * FROM provider_fuel_snapshots WHERE provider_id = :providerId AND timestamp >= :since ORDER BY timestamp ASC;

selectLatestProviderSnapshot:
SELECT * FROM provider_fuel_snapshots WHERE provider_id = :providerId ORDER BY timestamp DESC LIMIT 1;

selectAllLatestProviderSnapshots:
SELECT DISTINCT provider_id FROM provider_fuel_snapshots;

selectRecentProviderSnapshots:
SELECT * FROM provider_fuel_snapshots ORDER BY timestamp DESC LIMIT :limit;

selectProviderSnapshotsSince:
SELECT * FROM provider_fuel_snapshots WHERE timestamp >= :since ORDER BY timestamp ASC;

deleteOldProviderFuelSnapshots:
DELETE FROM provider_fuel_snapshots WHERE timestamp < :cutoff;

CREATE TABLE usage_records (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    source TEXT NOT NULL,
    model TEXT NOT NULL,
    conversation_id TEXT,
    input_tokens INTEGER NOT NULL DEFAULT 0,
    output_tokens INTEGER NOT NULL DEFAULT 0,
    request_count INTEGER NOT NULL DEFAULT 1,
    recorded_at INTEGER NOT NULL
);

insertUsageRecord:
INSERT INTO usage_records (timestamp, source, model, conversation_id, input_tokens, output_tokens, request_count, recorded_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectUsageSince:
SELECT * FROM usage_records WHERE timestamp >= :since ORDER BY timestamp ASC;

selectUsageBySourceSince:
SELECT source, SUM(input_tokens) AS total_input, SUM(output_tokens) AS total_output, SUM(request_count) AS total_requests FROM usage_records WHERE timestamp >= :since GROUP BY source ORDER BY SUM(input_tokens) DESC;

selectUsageByModelSince:
SELECT model, SUM(input_tokens) AS total_input, SUM(output_tokens) AS total_output, SUM(request_count) AS total_requests FROM usage_records WHERE timestamp >= :since GROUP BY model ORDER BY SUM(input_tokens) DESC;

selectUsageByConversationSince:
SELECT
    conversation_id,
    source,
    model,
    SUM(input_tokens) AS total_input,
    SUM(output_tokens) AS total_output,
    SUM(request_count) AS total_requests
FROM usage_records
WHERE timestamp >= :since AND conversation_id IS NOT NULL
GROUP BY conversation_id, source, model
ORDER BY SUM(input_tokens) DESC;

selectUsageByAgentModelSince:
SELECT
    source,
    model,
    SUM(input_tokens) AS total_input,
    SUM(output_tokens) AS total_output,
    SUM(request_count) AS total_requests
FROM usage_records
WHERE timestamp >= :since
GROUP BY source, model
ORDER BY SUM(input_tokens) DESC;

deleteOldUsageRecords:
DELETE FROM usage_records WHERE timestamp < :cutoff;

CREATE TABLE IF NOT EXISTS conversation_titles (
    conversation_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

insertConversationTitle:
INSERT OR REPLACE INTO conversation_titles (conversation_id, title, updated_at) VALUES (?, ?, ?);

selectAllConversationTitles:
SELECT conversation_id, title FROM conversation_titles;

selectUntitledUsageConversations:
SELECT DISTINCT conversation_id
FROM usage_records
WHERE conversation_id IS NOT NULL
  AND conversation_id NOT IN (SELECT conversation_id FROM conversation_titles)
LIMIT :limit;

CREATE TABLE model_drain_rates (
    model TEXT NOT NULL PRIMARY KEY,
    total_fuel_consumed REAL NOT NULL DEFAULT 0,
    sample_count INTEGER NOT NULL DEFAULT 0,
    active_agent_count_avg REAL NOT NULL DEFAULT 0,
    first_seen INTEGER NOT NULL,
    last_updated INTEGER NOT NULL,
    avg_drain_per_hr REAL NOT NULL DEFAULT 0
);

upsertModelDrainRate:
INSERT OR REPLACE INTO model_drain_rates (model, total_fuel_consumed, sample_count, active_agent_count_avg, first_seen, last_updated, avg_drain_per_hr)
VALUES (?, ?, ?, ?, ?, ?, ?);

incrementModelDrainRate:
UPDATE model_drain_rates
SET total_fuel_consumed = total_fuel_consumed + :delta,
    sample_count = sample_count + 1,
    active_agent_count_avg = (active_agent_count_avg * sample_count + :agent_count) / (sample_count + 1),
    last_updated = :timestamp,
    avg_drain_per_hr = (total_fuel_consumed + :delta) / ((:timestamp - first_seen) / 3600000.0)
WHERE model = :model;

selectAllModelDrainRates:
SELECT * FROM model_drain_rates ORDER BY total_fuel_consumed DESC;

CREATE TABLE ingested_runs (
    run_key TEXT NOT NULL PRIMARY KEY,
    connector_id TEXT NOT NULL,
    ingested_at INTEGER NOT NULL
);

insertIgnoredRun:
INSERT OR IGNORE INTO ingested_runs (run_key, connector_id, ingested_at) VALUES (?, ?, ?);

isRunIngested:
SELECT COUNT(*) >= 1 AS found FROM ingested_runs WHERE run_key = ?;

deleteOldIngestedRuns:
DELETE FROM ingested_runs WHERE ingested_at < :cutoff;

releaseIngestedRun:
DELETE FROM ingested_runs WHERE run_key = ?;

CREATE TABLE agent_model_history (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    agent_id TEXT NOT NULL,
    agent_name TEXT NOT NULL,
    model TEXT NOT NULL,
    valid_from INTEGER NOT NULL,
    valid_to INTEGER
);

closeOpenAgentModelRecords:
UPDATE agent_model_history SET valid_to = ? WHERE agent_id = ? AND valid_to IS NULL;

insertAgentModelRecord:
INSERT INTO agent_model_history (agent_id, agent_name, model, valid_from, valid_to) VALUES (?, ?, ?, ?, NULL);

selectModelAtTime:
SELECT model FROM agent_model_history WHERE agent_id = ? AND valid_from <= ? AND (valid_to IS NULL OR valid_to > ?) ORDER BY valid_from DESC LIMIT 1;

selectOpenAgentModels:
SELECT * FROM agent_model_history WHERE valid_to IS NULL;

selectAgentModelTimeline:
SELECT * FROM agent_model_history ORDER BY agent_id, valid_from;

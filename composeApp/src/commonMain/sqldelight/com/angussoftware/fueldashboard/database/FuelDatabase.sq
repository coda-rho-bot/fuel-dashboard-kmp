CREATE TABLE decisions (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    agent_id TEXT NOT NULL,
    model_handle TEXT NOT NULL,
    provider TEXT NOT NULL,
    tier TEXT NOT NULL,
    complexity TEXT NOT NULL,
    utilization_ratio REAL NOT NULL,
    headroom INTEGER NOT NULL,
    reason TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

insertDecision:
INSERT INTO decisions (agent_id, model_handle, provider, tier, complexity, utilization_ratio, headroom, reason, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRecentDecisions:
SELECT * FROM decisions ORDER BY timestamp DESC LIMIT :limit;

CREATE TABLE registered_agents (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    model TEXT,
    framework TEXT,
    command TEXT,
    status TEXT NOT NULL DEFAULT 'registered',
    registered_at INTEGER NOT NULL
);

upsertAgent:
INSERT OR REPLACE INTO registered_agents (id, name, model, framework, command, status, registered_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAgent:
DELETE FROM registered_agents WHERE id = ?;

selectAllAgents:
SELECT * FROM registered_agents;

deleteAllAgents:
DELETE FROM registered_agents;

CREATE TABLE fuel_snapshots (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    tokens_pct REAL,
    session_pct REAL,
    active_agent_count INTEGER NOT NULL DEFAULT 0,
    active_models TEXT,
    reset_at INTEGER
);

insertFuelSnapshot:
INSERT INTO fuel_snapshots (timestamp, tokens_pct, session_pct, active_agent_count, active_models, reset_at)
VALUES (?, ?, ?, ?, ?, ?);

selectRecentFuelSnapshots:
SELECT * FROM fuel_snapshots ORDER BY timestamp DESC LIMIT :limit;

selectFuelSnapshotsSince:
SELECT * FROM fuel_snapshots WHERE timestamp >= :since ORDER BY timestamp ASC;

deleteOldFuelSnapshots:
DELETE FROM fuel_snapshots WHERE timestamp < :cutoff;

CREATE TABLE provider_fuel_snapshots (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    provider_id TEXT NOT NULL,
    provider_name TEXT NOT NULL,
    provider_type TEXT NOT NULL,
    remaining_pct REAL,
    reset_at INTEGER,
    window_hours REAL
);

insertProviderFuelSnapshot:
INSERT INTO provider_fuel_snapshots (timestamp, provider_id, provider_name, provider_type, remaining_pct, reset_at, window_hours)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectProviderFuelSnapshots:
SELECT * FROM provider_fuel_snapshots WHERE provider_id = :providerId AND timestamp >= :since ORDER BY timestamp ASC;

selectLatestProviderSnapshot:
SELECT * FROM provider_fuel_snapshots WHERE provider_id = :providerId ORDER BY timestamp DESC LIMIT 1;

selectAllLatestProviderSnapshots:
SELECT DISTINCT provider_id FROM provider_fuel_snapshots;

selectRecentProviderSnapshots:
SELECT * FROM provider_fuel_snapshots ORDER BY timestamp DESC LIMIT :limit;

deleteOldProviderFuelSnapshots:
DELETE FROM provider_fuel_snapshots WHERE timestamp < :cutoff;

CREATE TABLE model_drain_rates (
    model TEXT NOT NULL PRIMARY KEY,
    total_fuel_consumed REAL NOT NULL DEFAULT 0,
    sample_count INTEGER NOT NULL DEFAULT 0,
    active_agent_count_avg REAL NOT NULL DEFAULT 0,
    first_seen INTEGER NOT NULL,
    last_updated INTEGER NOT NULL,
    avg_drain_per_hr REAL NOT NULL DEFAULT 0
);

upsertModelDrainRate:
INSERT OR REPLACE INTO model_drain_rates (model, total_fuel_consumed, sample_count, active_agent_count_avg, first_seen, last_updated, avg_drain_per_hr)
VALUES (?, ?, ?, ?, ?, ?, ?);

incrementModelDrainRate:
UPDATE model_drain_rates
SET total_fuel_consumed = total_fuel_consumed + :delta,
    sample_count = sample_count + 1,
    active_agent_count_avg = (active_agent_count_avg * sample_count + :agent_count) / (sample_count + 1),
    last_updated = :timestamp,
    avg_drain_per_hr = (total_fuel_consumed + :delta) / ((:timestamp - first_seen) / 3600000.0)
WHERE model = :model;

selectAllModelDrainRates:
SELECT * FROM model_drain_rates ORDER BY total_fuel_consumed DESC;
